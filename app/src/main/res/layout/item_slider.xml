<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="48dp"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:paddingVertical="4dp">

    <!-- dB readout (double tap to reset) -->
    <TextView
        android:id="@+id/tvGainVal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0.0"
        android:textColor="@color/neon_cyan"
        android:textSize="10sp"
        android:textStyle="bold"
        android:background="?selectableItemBackgroundBorderless"
        android:padding="2dp" />

    <!--
        Give the Slider a real horizontal measurement before rotation.
        Its width determines the travel distance of the thumb; wrap_content
        made the track very short even though the item itself was tall.
    -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipChildren="false"
        android:clipToPadding="false">

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderVertical"
            android:layout_width="240dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:rotation="270"
            android:valueFrom="-12.0"
            android:valueTo="12.0"
            android:stepSize="0.1"
            android:value="0.0"
            app:thumbColor="@color/neon_cyan"
            app:thumbRadius="7dp"
            app:haloRadius="18dp"
            app:trackHeight="5dp"
            app:trackColorActive="@color/neon_cyan"
            app:trackColorInactive="@color/slider_track_inactive"
            app:haloColor="@color/halo_cyan" />
    </FrameLayout>

    <!-- Frequency indicator -->
    <TextView
        android:id="@+id/tvFreqLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="1k"
        android:textColor="@color/text_primary"
        android:textSize="11sp"
        android:textStyle="bold" />
</LinearLayout>
