<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/amoled_black">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Header Toolbar -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SJBStudio EQ32"
                        android:textColor="@color/neon_cyan"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.05" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="35-BIQUAD DSP · 4-BAND MDRC · ZERO ROOT"
                        android:textColor="@color/text_secondary"
                        android:textSize="10sp"
                        android:letterSpacing="0.08" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_alignParentEnd="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnResetFlat"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="FLAT"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPresets"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PRESETS"
                        android:textColor="@color/neon_cyan"
                        android:backgroundTint="@color/surface_card"
                        android:textSize="12sp"
                        android:layout_marginStart="4dp" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchMasterPower"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        app:thumbTint="@color/neon_cyan"
                        app:trackTint="@color/surface_card" />
                </LinearLayout>
            </RelativeLayout>

            <!-- 3 Macro Tone Knobs (100Hz / 1000Hz / 8000Hz) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/surface_card"
                app:strokeColor="@color/stroke_subtle"
                app:strokeWidth="1dp"
                app:cardCornerRadius="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="12dp"
                    android:weightSum="3">

                    <!-- Bass 100Hz -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center_horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="BASS"
                            android:textColor="@color/text_primary"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="100 Hz Shelf"
                            android:textColor="@color/text_secondary"
                            android:textSize="9sp" />

                        <com.sjbstudio.eq32.ui.KnobView
                            android:id="@+id/knobBass"
                            android:layout_width="86dp"
                            android:layout_height="86dp"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>

                    <!-- Mid 1000Hz -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center_horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="MID"
                            android:textColor="@color/text_primary"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1.0 kHz Peak"
                            android:textColor="@color/text_secondary"
                            android:textSize="9sp" />

                        <com.sjbstudio.eq32.ui.KnobView
                            android:id="@+id/knobMid"
                            android:layout_width="86dp"
                            android:layout_height="86dp"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>

                    <!-- Treble 8000Hz -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center_horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="TREBLE"
                            android:textColor="@color/text_primary"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="8.0 kHz Shelf"
                            android:textColor="@color/text_secondary"
                            android:textSize="9sp" />

                        <com.sjbstudio.eq32.ui.KnobView
                            android:id="@+id/knobTreble"
                            android:layout_width="86dp"
                            android:layout_height="86dp"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- EqGraphView Curve (20Hz - 20,000Hz Log) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/surface_card"
                app:strokeColor="@color/stroke_subtle"
                app:strokeWidth="1dp"
                app:cardCornerRadius="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="COMPOSITE FREQUENCY RESPONSE (35 BIQUADS)"
                        android:textColor="@color/text_secondary"
                        android:textSize="9sp"
                        android:letterSpacing="0.05"
                        android:paddingStart="6dp"
                        android:paddingTop="2dp" />

                    <com.sjbstudio.eq32.ui.EqGraphView
                        android:id="@+id/eqGraphView"
                        android:layout_width="match_parent"
                        android:layout_height="140dp"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 32-Band Vertical Slider Horizontal Carousel -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/surface_card"
                app:strokeColor="@color/stroke_subtle"
                app:strokeWidth="1dp"
                app:cardCornerRadius="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="6dp"
                        android:paddingTop="2dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="32-BAND ISO GRAPHIC EQUALIZER (-12dB to +12dB)"
                            android:textColor="@color/text_secondary"
                            android:textSize="9sp"
                            android:letterSpacing="0.05" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="SWIPE HORIZONTALLY · TAP dB TO ZERO"
                            android:textColor="@color/text_secondary"
                            android:textSize="9sp"
                            android:layout_alignParentEnd="true" />
                    </RelativeLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvEqSliders"
                        android:layout_width="match_parent"
                        android:layout_height="280dp"
                        android:layout_marginTop="6dp"
                        android:overScrollMode="never" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 4-Band MDRC Dynamics Processing Section -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="@color/surface_card"
                app:strokeColor="@color/stroke_subtle"
                app:strokeWidth="1dp"
                app:cardCornerRadius="14dp">

                <com.sjbstudio.eq32.ui.MDRCView
                    android:id="@+id/mdrcView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="12dp" />
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
